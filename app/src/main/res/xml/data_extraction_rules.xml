<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and phone-to-phone transfer: the same rules as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="attendease_guest.db" />
        <exclude domain="database" path="attendease_guest.db-journal" />
        <exclude domain="database" path="attendease_guest.db-wal" />
        <exclude domain="database" path="attendease_guest.db-shm" />
        <exclude domain="sharedpref" path="attendease_prefs_guest.xml" />
        <exclude domain="sharedpref" path="attendease_mode.xml" />
        <exclude domain="file" path="last_crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="attendease_guest.db" />
        <exclude domain="database" path="attendease_guest.db-journal" />
        <exclude domain="database" path="attendease_guest.db-wal" />
        <exclude domain="database" path="attendease_guest.db-shm" />
        <exclude domain="sharedpref" path="attendease_prefs_guest.xml" />
        <exclude domain="sharedpref" path="attendease_mode.xml" />
        <exclude domain="file" path="last_crash.txt" />
    </device-transfer>
</data-extraction-rules>
